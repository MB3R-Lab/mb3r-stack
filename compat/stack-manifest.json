{
  "$schema": "../schemas/stack-manifest.schema.json",
  "schemaVersion": "1.1.0",
  "stack": {
    "name": "mb3r-stack",
    "version": "1.5.0",
    "status": "candidate",
    "releaseDate": "2026-10-29",
    "notes": [
      "Pins published Bering 1.3.0 at merged revision 70d4145d3e26f11d8b3fb5be8917c50c1c6d8c2a and its immutable OCI image digest.",
      "Adds a vendor-neutral ebpf-otlp source profile and Procrustes report/collection-plan 0.3.0 handoff without changing the historical ebpf-obi profile.",
      "Stack integration CI remains required before compatibility can be verified.",
      "Model/snapshot 1.3.0 and adapter envelope v1alpha1 contracts remain unchanged.",
      "Historical verified bundle evidence remains in its original compatibility-matrix entries."
    ]
  },
  "artifacts": {
    "chart": {
      "name": "mb3r-stack",
      "version": "1.5.0",
      "ociRepository": "oci://ghcr.io/mb3r-lab/charts",
      "package": "mb3r-stack-1.5.0.tgz"
    },
    "assetPack": {
      "version": "1.5.0",
      "archive": "mb3r-assets-1.5.0.tgz",
      "includes": [
        "collector/",
        "dashboards/",
        "examples/",
        "scripts/procrustes.py",
        "stack-manifest.json",
        "procrustes.md"
      ]
    },
    "dashboards": {
      "bering": "1.0.0",
      "sheaft": "1.0.0"
    },
    "configPacks": {
      "collector": "1.0.0",
      "examples": "1.5.0"
    }
  },
  "components": {
    "procrustes": {
      "version": "0.1.0",
      "source": {
        "repository": "https://github.com/MB3R-Lab/Procrustes.git",
        "commit": "9648ae3fe9ef24725e665d008c79d0681ce40f85"
      },
      "build": {
        "command": "go build -trimpath -o bin/procrustes ./cmd/procrustes"
      },
      "contracts": {
        "goal": "0.1.0",
        "report": "0.1.0",
        "collectionPlan": "0.1.0",
        "ebpfReport": "0.2.0",
        "ebpfCollectionPlan": "0.2.0",
        "genericEbpfReport": "0.3.0",
        "genericEbpfCollectionPlan": "0.3.0",
        "beringOverlay": "0.1.0"
      }
    },
    "bering": {
      "version": "1.3.0",
      "image": {
        "repository": "ghcr.io/mb3r-lab/bering",
        "tag": "v1.3.0",
        "digest": "sha256:95c29e311edfb5297c8bc22da6201a122f07e9492770a384fe93d8fac7d0da9c"
      },
      "contracts": {
        "collectorExport": "v1alpha1",
        "discoveryReport": "v1alpha1"
      },
      "source": {
        "repository": "https://github.com/MB3R-Lab/Bering.git",
        "commit": "70d4145d3e26f11d8b3fb5be8917c50c1c6d8c2a"
      }
    },
    "sheaft": {
      "version": "1.3.2",
      "image": {
        "repository": "ghcr.io/mb3r-lab/sheaft",
        "tag": "v1.3.2",
        "digest": "sha256:12e3999a87bf2cb8a472457c3f6534b40d2e3e84feefb250372abbe6a42a9187"
      },
      "contracts": {
        "gateDecision": "v1alpha1",
        "reportPayload": "v1alpha1"
      },
      "source": {
        "repository": "https://github.com/MB3R-Lab/Sheaft.git",
        "commit": "686a602f4e7b71f3612f1810885e29dd66c8733a"
      }
    }
  },
  "compatibilityMatrixRef": "compat/compatibility-matrix.json",
  "ownership": {
    "scope": [
      "stack-level compatibility",
      "generic bundle installation",
      "OTLP and artifact integration helpers",
      "profile examples and acceptance assets",
      "dashboards",
      "reusable CI integration adapters",
      "static preflight launcher and Bering overlay handoff"
    ],
    "notInScope": [
      "Bering core discovery logic",
      "Sheaft core simulation logic",
      "application platform source code",
      "Procrustes core static analysis"
    ]
  }
}
