{
  "$schema": "../schemas/stack-manifest.schema.json",
  "schemaVersion": "1.1.0",
  "stack": {
    "name": "mb3r-stack",
    "version": "1.4.0",
    "status": "candidate",
    "releaseDate": "2026-10-29",
    "notes": [
      "Candidate bundle for Bering 1.2.0 and Sheaft 1.3.2; full stack integration CI and publication remain pending.",
      "Bering source commit and OCI digest are pinned to its published v1.2.0 release manifest.",
      "Adds an opt-in Bering on_shutdown publication mode with reconciliation disabled explicitly; defaults remain windowed with reconciliation enabled.",
      "Model/snapshot 1.3.0 and adapter envelope v1alpha1 contracts remain unchanged.",
      "Historical 1.3.0 bundle evidence remains in its original compatibility-matrix entry."
    ]
  },
  "artifacts": {
    "chart": {
      "name": "mb3r-stack",
      "version": "1.4.0",
      "ociRepository": "oci://ghcr.io/mb3r-lab/charts",
      "package": "mb3r-stack-1.4.0.tgz"
    },
    "assetPack": {
      "version": "1.4.0",
      "archive": "mb3r-assets-1.4.0.tgz",
      "includes": [
        "collector/",
        "dashboards/",
        "examples/",
        "scripts/procrustes.py",
        "stack-manifest.json",
        "procrustes.md"
      ]
    },
    "dashboards": {
      "bering": "1.0.0",
      "sheaft": "1.0.0"
    },
    "configPacks": {
      "collector": "1.0.0",
      "examples": "1.4.0"
    }
  },
  "components": {
    "procrustes": {
      "version": "0.1.0",
      "source": {
        "repository": "https://github.com/MB3R-Lab/Procrustes.git",
        "commit": "39f76000f8a39c971155e08ebffde829b525911b"
      },
      "build": {
        "command": "go build -trimpath -o bin/procrustes ./cmd/procrustes"
      },
      "contracts": {
        "goal": "0.1.0",
        "report": "0.1.0",
        "collectionPlan": "0.1.0",
        "ebpfReport": "0.2.0",
        "ebpfCollectionPlan": "0.2.0",
        "beringOverlay": "0.1.0"
      }
    },
    "bering": {
      "version": "1.2.0",
      "image": {
        "repository": "ghcr.io/mb3r-lab/bering",
        "tag": "v1.2.0",
        "digest": "sha256:f706b79172a8322d53422de8d08a47d7779d0fbe2909511fa08385608b74c15b"
      },
      "contracts": {
        "collectorExport": "v1alpha1",
        "discoveryReport": "v1alpha1"
      },
      "source": {
        "repository": "https://github.com/MB3R-Lab/Bering.git",
        "commit": "6f806428509a640a6419058c2ad845ed44db7512"
      }
    },
    "sheaft": {
      "version": "1.3.2",
      "image": {
        "repository": "ghcr.io/mb3r-lab/sheaft",
        "tag": "v1.3.2",
        "digest": "sha256:12e3999a87bf2cb8a472457c3f6534b40d2e3e84feefb250372abbe6a42a9187"
      },
      "contracts": {
        "gateDecision": "v1alpha1",
        "reportPayload": "v1alpha1"
      },
      "source": {
        "repository": "https://github.com/MB3R-Lab/Sheaft.git",
        "commit": "686a602f4e7b71f3612f1810885e29dd66c8733a"
      }
    }
  },
  "compatibilityMatrixRef": "compat/compatibility-matrix.json",
  "ownership": {
    "scope": [
      "stack-level compatibility",
      "generic bundle installation",
      "OTLP and artifact integration helpers",
      "profile examples and acceptance assets",
      "dashboards",
      "reusable CI integration adapters",
      "static preflight launcher and Bering overlay handoff"
    ],
    "notInScope": [
      "Bering core discovery logic",
      "Sheaft core simulation logic",
      "application platform source code",
      "Procrustes core static analysis"
    ]
  }
}
