{
  "$schema": "../schemas/stack-manifest.schema.json",
  "schemaVersion": "1.1.0",
  "stack": {
    "name": "mb3r-stack",
    "version": "1.3.0",
    "status": "candidate",
    "releaseDate": "2026-10-28",
    "notes": [
      "Candidate integration update with published upstream release pins; stack verification is pending.",
      "Targets Bering 1.1.1 and Sheaft 1.3.2 with a separately pinned Procrustes source revision.",
      "Bering 1.1.1 commit and OCI digest match its published release manifest at https://github.com/MB3R-Lab/Bering/releases/tag/v1.1.1.",
      "Sheaft 1.3.2 commit and OCI digest match its published release manifest at https://github.com/MB3R-Lab/Sheaft/releases/tag/v1.3.2.",
      "The chart forwards bering.config.sources to Bering and provides an opt-in external OBI source profile.",
      "OBI remains a separately deployed Linux collector; Bering and Sheaft retain their existing unprivileged installation.",
      "Source domains separate collection context identities; agents in one collection deployment share a domain.",
      "Application predicates, fault laws, replica configuration and physical resource identity remain explicit inputs.",
      "Model/snapshot 1.3.0 is the target handoff line; compatibility is not yet verified.",
      "Full stack integration checks and review are required before publication."
    ]
  },
  "artifacts": {
    "chart": {
      "name": "mb3r-stack",
      "version": "1.3.0",
      "ociRepository": "oci://ghcr.io/mb3r-lab/charts",
      "package": "mb3r-stack-1.3.0.tgz"
    },
    "assetPack": {
      "version": "1.3.0",
      "archive": "mb3r-assets-1.3.0.tgz",
      "includes": [
        "collector/",
        "dashboards/",
        "examples/",
        "scripts/procrustes.py",
        "stack-manifest.json",
        "procrustes.md"
      ]
    },
    "dashboards": {
      "bering": "1.0.0",
      "sheaft": "1.0.0"
    },
    "configPacks": {
      "collector": "1.0.0",
      "examples": "1.3.0"
    }
  },
  "components": {
    "procrustes": {
      "version": "0.1.0",
      "source": {
        "repository": "https://github.com/MB3R-Lab/Procrustes.git",
        "commit": "39f76000f8a39c971155e08ebffde829b525911b"
      },
      "build": {
        "command": "go build -trimpath -o bin/procrustes ./cmd/procrustes"
      },
      "contracts": {
        "goal": "0.1.0",
        "report": "0.1.0",
        "collectionPlan": "0.1.0",
        "ebpfReport": "0.2.0",
        "ebpfCollectionPlan": "0.2.0",
        "beringOverlay": "0.1.0"
      }
    },
    "bering": {
      "version": "1.1.1",
      "image": {
        "repository": "ghcr.io/mb3r-lab/bering",
        "tag": "v1.1.1",
        "digest": "sha256:f39d2241d9631fec070ece4aa8e96687b16e1d480cef2a95d7a2f4db74da6cea"
      },
      "contracts": {
        "collectorExport": "v1alpha1",
        "discoveryReport": "v1alpha1"
      },
      "source": {
        "repository": "https://github.com/MB3R-Lab/Bering.git",
        "commit": "dccd1bca39b6ee85a79e5e245bdd2e727f0da1a3"
      }
    },
    "sheaft": {
      "version": "1.3.2",
      "image": {
        "repository": "ghcr.io/mb3r-lab/sheaft",
        "tag": "v1.3.2",
        "digest": "sha256:12e3999a87bf2cb8a472457c3f6534b40d2e3e84feefb250372abbe6a42a9187"
      },
      "contracts": {
        "gateDecision": "v1alpha1",
        "reportPayload": "v1alpha1"
      },
      "source": {
        "repository": "https://github.com/MB3R-Lab/Sheaft.git",
        "commit": "686a602f4e7b71f3612f1810885e29dd66c8733a"
      }
    }
  },
  "compatibilityMatrixRef": "compat/compatibility-matrix.json",
  "ownership": {
    "scope": [
      "stack-level compatibility",
      "generic bundle installation",
      "OTLP and artifact integration helpers",
      "profile examples and acceptance assets",
      "dashboards",
      "reusable CI integration adapters",
      "static preflight launcher and Bering overlay handoff"
    ],
    "notInScope": [
      "Bering core discovery logic",
      "Sheaft core simulation logic",
      "application platform source code",
      "Procrustes core static analysis"
    ]
  }
}
