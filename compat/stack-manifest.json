{
  "$schema": "../schemas/stack-manifest.schema.json",
  "schemaVersion": "1.0.0",
  "stack": {
    "name": "mb3r-stack",
    "version": "1.0.0",
    "status": "ga",
    "releaseDate": "2026-07-02",
    "notes": [
      "Generic integration and distribution layer only. No upstream Bering or Sheaft source code is vendored here.",
      "Verified v1 bundle for Bering v1.0.0 and Sheaft v1.0.0 artifacts with immutable GHCR image digests.",
      "OpenTelemetry Demo is packaged as an example profile, not as the core contract.",
      "Bering v1.0.0 publishes the 1.3.0 stochastic connectivity contract line with reliability evidence, operation-aware edge identity, endpoint semantic hints, and Sheaft compatibility fixtures.",
      "Sheaft v1.0.0 consumes the Bering v1 contract line and validates product-baseline P_Node * P_Edge stochastic connectivity with edge-aware immediate and eventual predicates.",
      "Stack verification covers release dry-run, synthetic-otlp live smoke, pinned-image startup, and adapter e2e checks."
    ]
  },
  "artifacts": {
    "chart": {
      "name": "mb3r-stack",
      "version": "1.0.0",
      "ociRepository": "oci://ghcr.io/mb3r-lab/charts",
      "package": "mb3r-stack-1.0.0.tgz"
    },
    "assetPack": {
      "version": "1.0.0",
      "archive": "mb3r-assets-1.0.0.tgz",
      "includes": [
        "collector/",
        "dashboards/",
        "examples/"
      ]
    },
    "dashboards": {
      "bering": "1.0.0",
      "sheaft": "1.0.0"
    },
    "configPacks": {
      "collector": "1.0.0",
      "examples": "1.0.0"
    }
  },
  "components": {
    "bering": {
      "version": "1.0.0",
      "image": {
        "repository": "ghcr.io/mb3r-lab/bering",
        "tag": "v1.0.0",
        "digest": "sha256:1da482d2629f695e0109525fb9c27e1fd8c502da85af4bbae95ddb176969c3d5"
      },
      "contracts": {
        "collectorExport": "v1alpha1",
        "discoveryReport": "v1alpha1"
      }
    },
    "sheaft": {
      "version": "1.0.0",
      "image": {
        "repository": "ghcr.io/mb3r-lab/sheaft",
        "tag": "v1.0.0",
        "digest": "sha256:195e38b6c4cf4e8cfab1d4ef86083bf9511c46e0617682d74b6768e43a4c9a07"
      },
      "contracts": {
        "gateDecision": "v1alpha1",
        "reportPayload": "v1alpha1"
      }
    }
  },
  "compatibilityMatrixRef": "compat/compatibility-matrix.json",
  "ownership": {
    "scope": [
      "stack-level compatibility",
      "generic bundle installation",
      "OTLP and artifact integration helpers",
      "profile examples and acceptance assets",
      "dashboards",
      "reusable CI integration adapters"
    ],
    "notInScope": [
      "Bering core discovery logic",
      "Sheaft core simulation logic",
      "application platform source code"
    ]
  }
}
